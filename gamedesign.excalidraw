      "created": 1790304566231,
      "link": null,
      "locked": false,
      "text": "const rooms = new Map()\n\n// Each room looks like:\n{\n  roomCode: \"902864\",\n  hostId: \"user-uuid\",\n  status: \"LOBBY\", // LOBBY | REVEAL | DISCUSSION | VOTING | RESULT\n  settings: {\n    numImposters: 2,\n    categories: [\"animals\", \"food\"],\n    totalPlayers: 20 // system max 20,\n    roomType: public / private\n  },\ngameInfo : {\n    category: sports,\n    word: cricket,\n     imposterWord: baseball,\n    imposterInfo: [ uuid1, uuid2 ]\n    \n},\n  players: [\n    {\n      userId: \"uuid\",\n      name: \"Neyaz\",\n      ws: <WebSocket instance>, // direct reference for private sends\n      isOnline: true,\n      isImposter: false,      // assigned at game start, never broadcast globally\n      hasVoted: false\n    }\n  ],\n  round1: {\n    impostorIds: [\"user-uuid\"],\n    votes: [\n                { \n                    voterId: uuid\n                    suspectedId: uuid\n            \n                },  \n        ]            // { voterId: suspectId }\n    timerInterval: null,   // server-side timer reference\n    secondsLeft: 120\n  },\n   round2: {\n    impostorIds: [\"user-uuid\"],\n    votes: [\n                { \n                    voterId: uuid\n                    suspectedId: uuid\n            \n                },  \n        ]            // { voterId: suspectId }\n    timerInterval: null,   // server-side timer reference\n    secondsLeft: 120\n  }\n\n\n}",
      "fontSize": 27.332099404348966,
      "baseFontSize": 97.33209940434897,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "const rooms = new Map()\n\n// Each room looks like:\n{\n  roomCode: \"902864\",\n  hostId: \"user-uuid\",\n  status: \"LOBBY\", // LOBBY | REVEAL | DISCUSSION | VOTING | RESULT\n  settings: {\n    numImposters: 2,\n    categories: [\"animals\", \"food\"],\n    totalPlayers: 20 // system max 20,\n    roomType: public / private\n  },\ngameInfo : {\n    category: sports,\n    word: cricket,\n     imposterWord: baseball,\n    imposterInfo: [ uuid1, uuid2 ]\n    \n},\n  players: [\n    {\n      userId: \"uuid\",\n      name: \"Neyaz\",\n      ws: <WebSocket instance>, // direct reference for private sends\n      isOnline: true,\n      isImposter: false,      // assigned at game start, never broadcast globally\n      hasVoted: false\n    }\n  ],\n  round1: {\n    impostorIds: [\"user-uuid\"],\n    votes: [\n                { \n                    voterId: uuid\n                    suspectedId: uuid\n            \n                },  \n        ]            // { voterId: suspectId }\n    timerInterval: null,   // server-side timer reference\n    secondsLeft: 120\n  },\n   round2: {\n    impostorIds: [\"user-uuid\"],\n    votes: [\n                { \n                    voterId: uuid\n                    suspectedId: uuid\n            \n                },  \n        ]            // { voterId: suspectId }\n    timerInterval: null,   // server-side timer reference\n    secondsLeft: 120\n  }\n\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
