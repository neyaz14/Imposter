    {
      "id": "shXFf7NHEK5jKs6_uhHt9",
      "type": "text",
      "x": -2060.1469431815203,
      "y": -2152.4920688737075,
      "width": 737.201904296875,
      "height": 2792.732558139537,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0j",
      "roundness": null,
      "seed": 156288445,
      "version": 117,
      "versionNonce": 1118382227,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790439115257,
      "created": 1790333662443,
      "link": null,
      "locked": false,
      "text": "const rooms = new Map<string, Room>();\n\ntype RoomStatus =\n  | \"LOBBY\"\n  | \"REVEAL\"\n  | \"DISCUSSION\"\n  | \"VOTING\"\n  | \"RESULT\"\n  | \"FINISHED\";\n\ninterface Room {\n  roomCode: string;\n  hostId: string;\n\n  status: RoomStatus;\n\n  settings: RoomSettings;\n\n  players: Map<string, Player>;\n\n  game: Game;\n\n  rounds: [Round, Round];\n\n  runtime: Runtime;\n}\n\ninterface RoomSettings {\n  numImposters: number;\n\n  categories: string[];\n\n  roomType: \"PUBLIC\" | \"PRIVATE\";\n}\n\ninterface Player {\n  userId: string;\n  name: string;\n\n  isOnline: boolean;\n  isReady: boolean;\n}\n\ninterface Game {\n  category: string;\n\n  normalWord: string;\n  imposterWord: string;\n\n  imposterIds: Set<string>;\n}\n\ninterface Round {\n  status: \"DISCUSSION\" | \"VOTING\" | \"RESULT\";\n\n  votes: Map<string, string>;\n\n  secondsLeft: number;\n}\n\ninterface Runtime {\n  connections: Map<string, WebSocket>;\n\n  timer: NodeJS.Timeout | null;\n}",
      "fontSize": 34.37209302325584,
      "baseFontSize": 44.37209302325584,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "const rooms = new Map<string, Room>();\n\ntype RoomStatus =\n  | \"LOBBY\"\n  | \"REVEAL\"\n  | \"DISCUSSION\"\n  | \"VOTING\"\n  | \"RESULT\"\n  | \"FINISHED\";\n\ninterface Room {\n  roomCode: string;\n  hostId: string;\n\n  status: RoomStatus;\n\n  settings: RoomSettings;\n\n  players: Map<string, Player>;\n\n  game: Game;\n\n  rounds: [Round, Round];\n\n  runtime: Runtime;\n}\n\ninterface RoomSettings {\n  numImposters: number;\n\n  categories: string[];\n\n  roomType: \"PUBLIC\" | \"PRIVATE\";\n}\n\ninterface Player {\n  userId: string;\n  name: string;\n\n  isOnline: boolean;\n  isReady: boolean;\n}\n\ninterface Game {\n  category: string;\n\n  normalWord: string;\n  imposterWord: string;\n\n  imposterIds: Set<string>;\n}\n\ninterface Round {\n  status: \"DISCUSSION\" | \"VOTING\" | \"RESULT\";\n\n  votes: Map<string, string>;\n\n  secondsLeft: number;\n}\n\ninterface Runtime {\n  connections: Map<string, WebSocket>;\n\n  timer: NodeJS.Timeout | null;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "UBJgNeRU5C9cmJuYGP0tt",
      "type": "text",
