      "updated": 1790439115257,
      "created": 1790333702224,
      "link": null,
      "locked": false,
      "text": "const room: Room = {\n  roomCode: \"902864\",\n\n  hostId: \"user-1\",\n\n  status: \"VOTING\",\n\n  settings: {\n    numImposters: 2,\n\n    categories: [\n      \"animals\",\n      \"food\",\n      \"sports\"\n    ],\n\n    roomType: \"PUBLIC\"\n  },\n\n  players: new Map([\n    [\n      \"user-1\",\n      {\n        userId: \"user-1\",\n        name: \"Neyaz\",\n        isOnline: true,\n        isReady: true\n      }\n    ],\n\n    [\n      \"user-2\",\n      {\n        userId: \"user-2\",\n        name: \"Rahim\",\n        isOnline: true,\n        isReady: true\n      }\n    ]\n  ]),\n\n  game: {\n    category: \"sports\",\n\n    normalWord: \"cricket\",\n\n    imposterWord: \"baseball\",\n\n    imposterIds: new Set([\n      \"user-4\",\n      \"user-8\"\n    ])\n  },\n\n  rounds: [\n    {\n      status: \"RESULT\",\n\n      votes: new Map([\n        [\"user-1\", \"user-4\"],\n        [\"user-2\", \"user-4\"]\n      ]),\n\n      secondsLeft: 0\n    },\n\n    {\n      status: \"VOTING\",\n\n      votes: new Map([\n        [\"user-1\", \"user-8\"]\n      ]),\n\n      secondsLeft: 87\n    }\n  ],\n\n  runtime: {\n    connections: new Map(),\n\n    timer: null\n  }\n};",
      "fontSize": 26.035087719297998,
      "baseFontSize": 54.035087719298,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "const room: Room = {\n  roomCode: \"902864\",\n\n  hostId: \"user-1\",\n\n  status: \"VOTING\",\n\n  settings: {\n    numImposters: 2,\n\n    categories: [\n      \"animals\",\n      \"food\",\n      \"sports\"\n    ],\n\n    roomType: \"PUBLIC\"\n  },\n\n  players: new Map([\n    [\n      \"user-1\",\n      {\n        userId: \"user-1\",\n        name: \"Neyaz\",\n        isOnline: true,\n        isReady: true\n      }\n    ],\n\n    [\n      \"user-2\",\n      {\n        userId: \"user-2\",\n        name: \"Rahim\",\n        isOnline: true,\n        isReady: true\n      }\n    ]\n  ]),\n\n  game: {\n    category: \"sports\",\n\n    normalWord: \"cricket\",\n\n    imposterWord: \"baseball\",\n\n    imposterIds: new Set([\n      \"user-4\",\n      \"user-8\"\n    ])\n  },\n\n  rounds: [\n    {\n      status: \"RESULT\",\n\n      votes: new Map([\n        [\"user-1\", \"user-4\"],\n        [\"user-2\", \"user-4\"]\n      ]),\n\n      secondsLeft: 0\n    },\n\n    {\n      status: \"VOTING\",\n\n      votes: new Map([\n        [\"user-1\", \"user-8\"]\n      ]),\n\n      secondsLeft: 87\n    }\n  ],\n\n  runtime: {\n    connections: new Map(),\n\n    timer: null\n  }\n};",
      "autoResize": true,
