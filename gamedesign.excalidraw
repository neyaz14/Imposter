      "text": "{\n  \"event\": \"room_state\",\n  \"payload\": {\n    \"roomCode\": \"902864\",\n    \"hostId\": \"user-1\",\n    \"status\": \"LOBBY\",\n    \"settings\": {\n      \"numImposters\": 2,\n      \"categories\": [\n        \"animals\",\n        \"food\",\n        \"sports\"\n      ],\n      \"roomType\": \"PUBLIC\"\n    },\n    \"players\": [\n      {\n        \"userId\": \"user-1\",\n        \"name\": \"Neyaz\",\n        \"isOnline\": true,\n        \"isReady\": true\n      },\n      {\n        \"userId\": \"user-2\",\n        \"name\": \"Rahim\",\n        \"isOnline\": true,\n        \"isReady\": false\n      }\n    ],\n    \"playerCount\": 2,\n    \"maxPlayers\": 20\n  }\n}",
